type TokenStandard = variant {
    ERC20;
    ERC721;
    ERC1155;
};

type TokenMetadata = record {
    standard: TokenStandard;
    chain_id: nat64;
    token_address: text;
    token_id: opt text;
};

type TokenOwnershipInput = record {
    token: TokenMetadata;
    owner_address: text;
    balance: text;
    block_number: nat64;
    proof_data: vec text;
};

type ProofResult = variant {
    Success: vec nat8;
    Error: text;
};

type VerificationResult = variant {
    Success: bool;
    Error: text;
};

service : {
    "prove_ownership": (principal, TokenOwnershipInput) -> (ProofResult);
    "verify_proof": (vec nat8) -> (VerificationResult) query;
}; 