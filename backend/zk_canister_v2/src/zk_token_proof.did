type TokenOwnershipInput = record {
  balance: nat64;
  min_range: nat64;
  max_range: nat64;
};

type Result = variant {
  Ok: nat64;
  Err: text;
};

type VerifyResult = variant {
  Ok: bool;
  Err: text;
};

type CanisterMetrics = record {
  total_proofs_generated: nat64;
  total_proofs_verified: nat64;
  avg_proof_generation_time_ms: nat64;
  avg_proof_verification_time_ms: nat64;
  total_errors: nat64;
  error_types: vec record { text; nat64 };
};

type HealthStatus = record {
  status: text;
  cycles: nat64;
  memory_mb: float64;
  timestamp: nat64;
};

type HealthResult = variant {
  Ok: HealthStatus;
  Err: text;
};

service : {
  "generate_proof": (TokenOwnershipInput) -> (Result);
  "verify_proof_by_id": (text) -> (VerifyResult) query;
  "get_canister_metrics": () -> (CanisterMetrics) query;
  "health_check": () -> (HealthResult) query;
} 