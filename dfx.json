{
  "canisters": {
    "zk_canister": {
      "candid": "backend/zk_canister/zk_canister.did",
      "package": "zk_canister",
      "type": "rust",
      "source": ["backend/zk_canister/src"],
      "metadata": [
        {
          "name": "candid:service",
          "path": "backend/zk_canister/zk_canister.did"
        }
      ]
    },
    "main_canister": {
      "candid": "backend/main_canister/main_canister.did",
      "package": "main_canister",
      "type": "rust",
      "source": ["backend/main_canister/src"],
      "metadata": [
        {
          "name": "candid:service",
          "path": "backend/main_canister/main_canister.did"
        }
      ]
    },
    "zk_canister_v2": {
      "candid": "backend/zk_canister_v2/src/zk_token_proof.did",
      "package": "zk_canister_v2",
      "type": "rust",
      "source": ["backend/zk_canister_v2/src"],
      "metadata": [
        {
          "name": "candid:service",
          "path": "backend/zk_canister_v2/src/zk_token_proof.did"
        }
      ]
    },
    "frontend": {
      "dependencies": [
        "zk_canister_v2"
      ],
      "frontend": {
        "entrypoint": "src/index.html"
      },
      "source": [
        "src/",
        "dist/"
      ],
      "type": "assets"
    }
  },
  "defaults": {
    "build": {
      "args": "",
      "packtool": ""
    }
  },
  "output_env_file": ".env",
  "version": 1,
  "networks": {
    "local": {
      "bind": "127.0.0.1:8000",
      "type": "ephemeral"
    },
    "staging": {
      "providers": ["https://icp0.io"],
      "type": "persistent",
      "wallet": {
        "canister": "h5yqz-nqaaa-aaaad-aalnq-cai"
      }
    },
    "ic": {
      "providers": ["https://ic0.app"],
      "type": "persistent"
    }
  }
} 